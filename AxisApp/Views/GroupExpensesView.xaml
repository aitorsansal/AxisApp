<?xml version="1.0" encoding="utf-8"?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    xmlns:controls="clr-namespace:AxisApp.Controls"
    xmlns:local="clr-namespace:AxisApp"
    xmlns:loc="clr-namespace:AxisApp.Localization"
    x:Class="AxisApp.Views.GroupExpensesView"
    x:DataType="vm:GroupExpensesViewModel">

    <!-- Balances + Recent Activity — moved verbatim out of GroupDetailPage (see /EVENTS_PLAN.md
    Milestone 2), bound to GroupExpensesViewModel via BindingContext set on this control's usage
    site in GroupDetailPage.xaml, not to GroupDetailViewModel. The FAB stays at the page level
    (it context-switches between this tab and Events), so it isn't duplicated here. -->
    <Grid>
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="{StaticResource SpacingL}">
                <!-- Bottom padding reserves clearance under the floating "+ Add expense"
                button (FabButtonStyle) so it never permanently covers the last list row. -->
                <VerticalStackLayout.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingM}" Right="{StaticResource SpacingM}" Bottom="88" />
                </VerticalStackLayout.Padding>

                <!-- Skeleton: shown only while the initial load (balances + activity) is in
                     flight — mirrors the two real sections below it (a couple of balance tiles,
                     a few activity rows) rather than a generic block, and LoadAsync pads itself
                     out to a minimum visible duration (WithMinimumDurationAsync) so this never
                     just flashes and disappears on a fast connection. -->
                <VerticalStackLayout Spacing="{StaticResource SpacingL}" IsVisible="{Binding IsBusy}">
                    <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                        <controls:SkeletonBox WidthRequest="80" HeightRequest="12" HorizontalOptions="Start" />
                        <controls:SkeletonBox HeightRequest="64" />
                        <controls:SkeletonBox HeightRequest="64" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                        <controls:SkeletonBox WidthRequest="110" HeightRequest="12" HorizontalOptions="Start" />
                        <controls:SkeletonBox HeightRequest="64" />
                        <controls:SkeletonBox HeightRequest="64" />
                        <controls:SkeletonBox HeightRequest="64" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpacingS}" IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
                        <Label Grid.Column="0" Text="{loc:Translate GroupDetail_Balances}" Style="{StaticResource SectionHeaderTertiary}" VerticalOptions="Center" Margin="0" />
                        <Label
                            Grid.Column="1"
                            Text="{loc:Translate GroupDetail_Detailed}"
                            Style="{StaticResource LabelTertiary}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="2" IsToggled="{Binding IsPairwiseMode}" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Balances}" Spacing="{StaticResource SpacingS}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemberBalanceItem">
                                <Border Style="{StaticResource BalanceTileSettled}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsOwed}" Value="True">
                                            <Setter Property="Style" Value="{StaticResource BalanceTileReceive}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsOwing}" Value="True">
                                            <Setter Property="Style" Value="{StaticResource BalanceTilePay}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                        <controls:ProfileCircle
                                            Grid.Column="0"
                                            ImageUrl="{Binding AvatarUrl}"
                                            Initials="{Binding Initials}"
                                            Diameter="{StaticResource AvatarSizeM}"
                                            Opacity="0.85" />
                                        <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" FontAttributes="Bold" LineBreakMode="TailTruncation">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOwing}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                            <controls:AnimatedValueLabel Text="{Binding AmountText}" FontSize="{StaticResource TypeTitle}" FontAttributes="Bold" HorizontalTextAlignment="End">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOwing}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </controls:AnimatedValueLabel>
                                            <Label Text="{Binding CaptionText}" FontSize="{StaticResource TypeCaption}" HorizontalTextAlignment="End">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOwing}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="3"
                                            Text="{loc:Translate GroupDetail_Settle}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupExpensesViewModel}}, Path=SettleCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BtnOutlinePrimary}"
                                            FontSize="{StaticResource TypeCaption}"
                                            Padding="{StaticResource SpacingS}"
                                            MinimumHeightRequest="36"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpacingS}" IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                    <Label Text="{loc:Translate GroupDetail_RecentActivity}" Style="{StaticResource SectionHeaderTertiary}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivity}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityItem">
                                <Border Style="{StaticResource ListItemCard}" controls:Juice.PressScale="0.97">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupExpensesViewModel}}, Path=OpenActivityCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                        <Border Grid.Column="0" Style="{StaticResource AvatarCircle}" WidthRequest="{StaticResource AvatarSizeM}" HeightRequest="{StaticResource AvatarSizeM}">
                                            <Label
                                                Text="{x:Static local:AppConstants+Icons.ShoppingCart}"
                                                FontFamily="Lucide"
                                                FontSize="{StaticResource TypeBody}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSettlement}" Value="True">
                                                        <Setter Property="Text" Value="{x:Static local:AppConstants+Icons.ArrowRight}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Description}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding SubCaption}" Style="{StaticResource LabelTertiary}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                            <controls:AnimatedValueLabel
                                                Text="{Binding AmountText}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End" />
                                            <Label
                                                Text="{Binding SecondaryAmountText}"
                                                Style="{StaticResource LabelTertiary}"
                                                FontSize="{StaticResource TypeCaption}"
                                                HorizontalTextAlignment="End"
                                                IsVisible="{Binding SecondaryAmountText, Converter={StaticResource StringNotEmptyConverter}}" />
                                            <Label Text="{Binding RelativeDate}" Style="{StaticResource LabelTertiary}" HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

    <controls:ErrorPopup Message="{Binding ErrorMessage}" />
    </Grid>
</ContentView>
