namespace AxisApp;

/// <summary>
/// Copy this file to Config.Local.cs (gitignored) and fill in your own project's values —
/// see /supabase/README.md step 4 for where to find them.
/// </summary>
internal static class SupabaseConfig
{
    public const string Url = "https://YOUR-PROJECT-REF.supabase.co";
    public const string PublishableKey = "sb_publishable_...";

    /// <summary>The Web OAuth client id entered in Supabase Dashboard -> Authentication ->
    /// Providers -> Google. Used directly by Android's GoogleAuthService (Credential Manager's
    /// SetServerClientId) — Windows' GoogleAuthService doesn't need this at all, since it goes
    /// through Supabase's own authorize endpoint instead of talking to Google directly.</summary>
    public const string GoogleWebClientId = "YOUR-WEB-CLIENT-ID.apps.googleusercontent.com";
}
