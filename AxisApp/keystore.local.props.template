<Project>
	<!--
	Copia este fichero como "keystore.local.props" (mismo directorio) y rellena los valores reales.
	"keystore.local.props" está en .gitignore: nunca se sube al repositorio.
	El keystore (pda.keystore) y las contraseñas se comparten por un canal seguro
	(gestor de contraseñas, etc.), nunca por git ni por chat en claro.
	-->
	<PropertyGroup>
		<AndroidSigningKeyStore>keystore\pda.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>pda</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>REEMPLAZAR</AndroidSigningStorePass>
		<AndroidSigningKeyPass>REEMPLAZAR</AndroidSigningKeyPass>
	</PropertyGroup>
</Project>
