<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:AxisApp.Localization"
    xmlns:services="clr-namespace:AxisApp.Services"
    x:Class="AxisApp.Controls.UpdateBanner"
    x:DataType="services:AppUpdateService">

    <!-- BindingContext is set to AppUpdateService.Instance in code-behind, independent of
         whatever ViewModel the host page is bound to — this sits as an always-present last
         child on every page (same "no per-page IsVisible binding needed" shape as ErrorPopup)
         and shows/hides purely off the shared update-check singleton. -->
    <Border
        Style="{StaticResource ElevatedCard}"
        IsVisible="{Binding ShouldShowBanner}"
        HorizontalOptions="Fill"
        VerticalOptions="End"
        Margin="{StaticResource SpacingM}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
            <Label
                Grid.Column="0"
                Text="{loc:Translate Update_Message}"
                VerticalOptions="Center"
                LineBreakMode="WordWrap" />

            <Label
                Grid.Column="1"
                Text="{loc:Translate Update_Action}"
                TextColor="{DynamicResource Primary}"
                FontAttributes="Bold"
                VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUpdateTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label
                Grid.Column="2"
                Text="✕"
                Style="{StaticResource LabelTertiary}"
                VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Border>
</ContentView>
