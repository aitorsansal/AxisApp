<?xml version="1.0" encoding="utf-8" ?>
<!--
  Tokens.xaml — design tokens for spacing, radius, type sizes, and motion.
  No colors here; the project's dark palette stays in Colors.xaml.
  Reference these via StaticResource. Do not hard-code numeric values in views.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============ SPACING SCALE (4 / 8 base) ============ -->
    <!-- One scale for every margin, padding, and gap. Off-scale values are wrong. -->
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">16</x:Double>
    <x:Double x:Key="SpacingL">24</x:Double>
    <x:Double x:Key="SpacingXL">40</x:Double>
    <x:Double x:Key="SpacingXXL">64</x:Double>

    <!-- ============ RADIUS SCALE ============ -->
    <!-- Radius* (Int32): for Button.CornerRadius.
         Shape*  (CornerRadius struct): for RoundRectangle.CornerRadius on Border.StrokeShape.
         Values are paired and must stay in sync. -->
    <x:Int32 x:Key="RadiusControl">8</x:Int32>
    <x:Int32 x:Key="RadiusCard">12</x:Int32>
    <x:Int32 x:Key="RadiusPill">999</x:Int32>

    <CornerRadius x:Key="ShapeControl">8</CornerRadius>
    <CornerRadius x:Key="ShapeCard">12</CornerRadius>
    <CornerRadius x:Key="ShapePill">999</CornerRadius>

    <!-- ============ TYPE RAMP (5 roles) ============ -->
    <!-- Sizes calibrated to a dense mobile UI (14 body, not the 16 of the light preset). -->
    <x:Double x:Key="TypeDisplay">28</x:Double>
    <x:Double x:Key="TypeTitle">17</x:Double>
    <x:Double x:Key="TypeBody">14</x:Double>
    <x:Double x:Key="TypeCaption">12</x:Double>
    <x:Double x:Key="TypeLabel">11</x:Double>

    <!-- ============ MOTION DURATIONS (ms) ============ -->
    <!-- Press feedback at the floor; entries quiet; modals capped under 300ms. -->
    <x:Int32 x:Key="DurationPress">120</x:Int32>
    <x:Int32 x:Key="DurationTooltip">160</x:Int32>
    <x:Int32 x:Key="DurationEntry">220</x:Int32>
    <x:Int32 x:Key="DurationModal">280</x:Int32>

</ResourceDictionary>
