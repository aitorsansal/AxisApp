<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    xmlns:controls="clr-namespace:AxisApp.Controls"
    xmlns:loc="clr-namespace:AxisApp.Localization"
    x:Class="AxisApp.Pages.MembersPage"
    x:DataType="vm:MembersViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding GroupName}">

    <Grid>
    <Grid RowDefinitions="Auto,*">

        <controls:PageHeaderBar Grid.Row="0" HeaderTitle="{Binding GroupName}" />

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="{StaticResource SpacingM}" Spacing="{StaticResource SpacingL}">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                        <Label Grid.Column="0" Text="{loc:Translate Members_SectionHeader}" Style="{StaticResource SectionHeaderTertiary}" VerticalOptions="Center" Margin="0" />
                        <Button
                            Grid.Column="1"
                            Text="{loc:Translate GroupDetail_InvitePeople}"
                            Command="{Binding InvitePeopleCommand}"
                            Style="{StaticResource BtnOutlinePrimary}"
                            FontSize="{StaticResource TypeCaption}"
                            Padding="{StaticResource SpacingS}"
                            MinimumHeightRequest="36"
                            VerticalOptions="Center" />
                    </Grid>

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="{DynamicResource Danger}"
                        FontSize="{StaticResource TypeCaption}"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}" Spacing="{StaticResource SpacingS}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemberRowItem">
                                <Border Style="{StaticResource ListItemCard}">
                                    <Grid ColumnDefinitions="36,*,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                        <controls:ProfileCircle
                                            Grid.Column="0"
                                            ImageUrl="{Binding AvatarUrl}"
                                            Initials="{Binding Initials}"
                                            Diameter="{StaticResource AvatarSizeM}">
                                            <controls:ProfileCircle.Triggers>
                                                <DataTrigger TargetType="controls:ProfileCircle" Binding="{Binding IsYou}" Value="True">
                                                    <Setter Property="Kind" Value="Primary" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="controls:ProfileCircle" Binding="{Binding IsPhantom}" Value="True">
                                                    <Setter Property="Kind" Value="Phantom" />
                                                </DataTrigger>
                                            </controls:ProfileCircle.Triggers>
                                        </controls:ProfileCircle>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{loc:Translate Members_You}" Style="{StaticResource LabelTertiary}" IsVisible="{Binding IsYou}" />
                                            <Label Text="{loc:Translate JoinGroup_PhantomMember}" Style="{StaticResource LabelTertiary}" IsVisible="{Binding IsPhantom}" />
                                        </VerticalStackLayout>
                                        <Border
                                            Grid.Column="2"
                                            BackgroundColor="Transparent"
                                            StrokeThickness="0"
                                            WidthRequest="36" HeightRequest="36"
                                            Padding="0"
                                            VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MembersViewModel}}, Path=OpenRenameOverlayCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="&#9998;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{DynamicResource TextTertiary}" />
                                        </Border>
                                        <Button
                                            Grid.Column="3"
                                            Text="{loc:Translate Members_Remove}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MembersViewModel}}, Path=RemoveMemberCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BtnOutlinePrimary}"
                                            TextColor="{DynamicResource Danger}"
                                            FontSize="{StaticResource TypeCaption}"
                                            Padding="{StaticResource SpacingS}"
                                            MinimumHeightRequest="36"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsPhantom}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>

    <!-- Inline rename overlay — not Shell.Current.DisplayPromptAsync, which fail-fasts on Windows
    (see MembersViewModel.OpenRenameOverlay's remarks). Same scrim+card pattern as GroupDetailPage's
    transfer-ownership picker. -->
    <BoxView Color="Transparent" IsVisible="{Binding IsRenameOverlayOpen}">
        <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CancelRenameOverlayCommand}" />
        </BoxView.GestureRecognizers>
    </BoxView>

    <Border
        Style="{StaticResource ElevatedCard}"
        IsVisible="{Binding IsRenameOverlayOpen}"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        WidthRequest="280">
        <VerticalStackLayout Spacing="{StaticResource SpacingS}">
            <Border Style="{StaticResource InputBorderStyle}">
                <Entry Text="{Binding RenameInput}" />
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingS}">
                <Button
                    Grid.Column="0"
                    Text="{loc:Translate Common_Cancel}"
                    Command="{Binding CancelRenameOverlayCommand}"
                    Style="{StaticResource BtnOutlinePrimary}" />
                <Button
                    Grid.Column="1"
                    Text="{loc:Translate Common_Save}"
                    Command="{Binding ConfirmRenameCommand}"
                    Style="{StaticResource BtnPrimaryStyle}" />
            </Grid>
        </VerticalStackLayout>
    </Border>
    </Grid>
</ContentPage>
