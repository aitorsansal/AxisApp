<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    x:Class="AxisApp.Pages.LoginPage"
    x:DataType="vm:LoginViewModel"
    Title="Axis">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="{StaticResource SpacingL}"
                Spacing="{StaticResource SpacingM}">

                <Label
                    Text="Axis"
                    FontSize="{StaticResource TypeDisplay}"
                    FontAttributes="Bold"
                    HorizontalOptions="Center">
                    <Label.Margin>
                        <Thickness Left="0" Top="0" Right="0" Bottom="{StaticResource SpacingL}" />
                    </Label.Margin>
                </Label>

                <Border Style="{StaticResource InputBorderStyle}">
                    <Entry
                        Text="{Binding Email}"
                        Placeholder="Email"
                        Keyboard="Email"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                </Border>

                <Border Style="{StaticResource InputBorderStyle}">
                    <Entry
                        Text="{Binding Password}"
                        Placeholder="Password"
                        IsPassword="True"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                </Border>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource Danger}"
                    FontSize="{StaticResource TypeCaption}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <Button
                    Text="Sign In"
                    Command="{Binding SignInCommand}"
                    Style="{StaticResource BtnPrimaryStyle}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                <Button
                    Text="Create Account"
                    Command="{Binding SignUpCommand}"
                    Style="{StaticResource BtnOutlinePrimary}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

            </VerticalStackLayout>
        </ScrollView>

        <BoxView
            Color="{StaticResource BgDeep}"
            Opacity="0.6"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False" />

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Primary}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>
</ContentPage>
