<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AxisApp.Pages.SplashPage"
    Title="Axis"
    Shell.NavBarIsVisible="False">

    <Grid>
        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="{StaticResource SpacingL}">

            <Label
                Text="Axis"
                FontSize="{StaticResource TypeDisplay}"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <ActivityIndicator
                IsRunning="True"
                Color="{StaticResource Primary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>
