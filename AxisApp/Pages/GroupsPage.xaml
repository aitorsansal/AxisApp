<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    xmlns:controls="clr-namespace:AxisApp.Controls"
    xmlns:loc="clr-namespace:AxisApp.Localization"
    x:Class="AxisApp.Pages.GroupsPage"
    x:DataType="vm:GroupsViewModel"
    Shell.NavBarIsVisible="False"
    Title="{loc:Translate Groups_Title}">

    <Grid>
    <Grid RowDefinitions="60,*">

        <!-- Top bar: wordmark left, user avatar right -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Grid.Padding>
                <Thickness Left="{StaticResource SpacingM}" Top="0" Right="{StaticResource SpacingM}" Bottom="0" />
            </Grid.Padding>
            <Label
                Grid.Column="0"
                Text="Axis"
                FontSize="{StaticResource TypeWordmark}"
                FontAttributes="Bold"
                VerticalOptions="Center" />
            <Border
                Grid.Column="1"
                BackgroundColor="Transparent"
                StrokeThickness="0"
                WidthRequest="44" HeightRequest="44"
                Padding="{StaticResource SpacingXS}"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleAccountMenuCommand}" />
                </Border.GestureRecognizers>
                <controls:ProfileCircle
                    ImageUrl="{Binding MyAvatarUrl}"
                    Initials="{Binding UserInitials}"
                    Kind="Primary"
                    Diameter="{StaticResource AvatarSizeM}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
                <ScrollView>
                    <VerticalStackLayout Padding="{StaticResource SpacingM}" Spacing="{StaticResource SpacingS}">

                        <Label
                            Text="{Binding ErrorMessage}"
                            TextColor="{StaticResource Danger}"
                            FontSize="{StaticResource TypeCaption}"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate Groups_YourGroups}" Style="{StaticResource SectionHeaderTertiary}" VerticalOptions="Center" />
                            <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" Padding="{StaticResource SpacingS}" VerticalOptions="Center">
                                <Label
                                    Text="{loc:Translate Groups_JoinWithCode}"
                                    TextColor="{StaticResource Primary}"
                                    FontSize="{StaticResource TypeCaption}"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding JoinGroupCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="{StaticResource SpacingS}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:GroupListItem">
                                    <Border Style="{StaticResource ListItemCard}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupsViewModel}}, Path=OpenGroupCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource SpacingXS}">
                                            <Label
                                                Grid.Row="0" Grid.Column="0"
                                                Text="{Binding Group.Name}"
                                                FontSize="{StaticResource TypeTitle}"
                                                FontAttributes="Bold"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />

                                            <Label
                                                Grid.Row="0" Grid.Column="1"
                                                Text="{Binding BalanceAmountText}"
                                                FontSize="{StaticResource TypeBody}"
                                                FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOwing}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSettled}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <HorizontalStackLayout
                                                Grid.Row="1" Grid.Column="0"
                                                Spacing="-6"
                                                BindableLayout.ItemsSource="{Binding AvatarInitials}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border
                                                            Style="{StaticResource AvatarCircle}"
                                                            WidthRequest="{StaticResource AvatarSizeXS}" HeightRequest="{StaticResource AvatarSizeXS}"
                                                            Stroke="{StaticResource BgPrimary}"
                                                            StrokeThickness="2">
                                                            <Label Text="{Binding .}" Style="{StaticResource AvatarInitialsLabel}" FontSize="{StaticResource TypeLabel}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>

                                            <Label
                                                Grid.Row="2" Grid.Column="0"
                                                Text="{Binding MemberSummary}"
                                                Style="{StaticResource LabelTertiary}"
                                                LineBreakMode="TailTruncation" />

                                            <Label
                                                Grid.Row="2" Grid.Column="1"
                                                Text="{Binding BalanceCaptionText}"
                                                Style="{StaticResource LabelTertiary}"
                                                HorizontalOptions="End" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label
                            Text="{loc:Translate Groups_EmptyState}"
                            Style="{StaticResource LabelTertiary}"
                            IsVisible="{Binding IsEmpty}"
                            HorizontalOptions="Center">
                            <Label.Margin>
                                <Thickness Left="0" Top="{StaticResource SpacingXL}" Right="0" Bottom="0" />
                            </Label.Margin>
                        </Label>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <Button
                Text="+"
                Command="{Binding NewGroupCommand}"
                Style="{StaticResource FabButtonStyle}" />
        </Grid>
    </Grid>

    <!-- Scrim: tap anywhere outside the account menu to dismiss it -->
    <BoxView
        Color="Transparent"
        IsVisible="{Binding IsAccountMenuOpen}">
        <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ToggleAccountMenuCommand}" />
        </BoxView.GestureRecognizers>
    </BoxView>

    <Border
        Style="{StaticResource ElevatedCard}"
        IsVisible="{Binding IsAccountMenuOpen}"
        HorizontalOptions="End"
        VerticalOptions="Start"
        Margin="0,58,16,0"
        WidthRequest="200"
        Padding="0">
        <VerticalStackLayout>
            <Label
                Text="{Binding UserEmail}"
                Style="{StaticResource LabelTertiary}"
                LineBreakMode="TailTruncation">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
            </Label>
            <BoxView Style="{StaticResource SectionDivider}" HeightRequest="1" />
            <Label Text="{loc:Translate Groups_ChangePhoto}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangePhotoCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="{loc:Translate Groups_RemovePhoto}" TextColor="{StaticResource Danger}" IsVisible="{Binding MyAvatarUrl, Converter={StaticResource StringNotEmptyConverter}}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RemovePhotoCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <BoxView Style="{StaticResource SectionDivider}" HeightRequest="1" />
            <Label Text="{loc:Translate Groups_Language}" Style="{StaticResource LabelTertiary}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="0" />
                </Label.Padding>
            </Label>
            <Label Text="{loc:Translate Groups_LanguageSystem}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingXS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingXS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeLanguageCommand}" CommandParameter="" />
                </Label.GestureRecognizers>
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding SelectedLanguageOverride}" Value="">
                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                        <Setter Property="FontAttributes" Value="Bold" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label Text="{loc:Translate Groups_LanguageEnglish}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingXS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingXS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeLanguageCommand}" CommandParameter="en" />
                </Label.GestureRecognizers>
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding SelectedLanguageOverride}" Value="en">
                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                        <Setter Property="FontAttributes" Value="Bold" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label Text="{loc:Translate Groups_LanguageSpanish}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingXS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeLanguageCommand}" CommandParameter="es" />
                </Label.GestureRecognizers>
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding SelectedLanguageOverride}" Value="es">
                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                        <Setter Property="FontAttributes" Value="Bold" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <BoxView Style="{StaticResource SectionDivider}" HeightRequest="1" />
            <Label Text="{loc:Translate Groups_LogOut}" TextColor="{StaticResource Danger}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </Border>
    </Grid>
</ContentPage>
