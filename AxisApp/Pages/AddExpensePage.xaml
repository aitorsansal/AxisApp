<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    xmlns:controls="clr-namespace:AxisApp.Controls"
    xmlns:loc="clr-namespace:AxisApp.Localization"
    x:Class="AxisApp.Pages.AddExpensePage"
    x:DataType="vm:AddExpenseViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding PageTitle}">

    <Grid RowDefinitions="60,*,Auto">

        <!-- Top bar: Cancel / title / Save -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Grid.Padding>
                <Thickness Left="{StaticResource SpacingM}" Top="0" Right="{StaticResource SpacingM}" Bottom="0" />
            </Grid.Padding>
            <Button
                Grid.Column="0"
                Text="{loc:Translate Common_Cancel}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource BtnTextStyle}"
                TextColor="{DynamicResource TextSecondary}"
                MinimumWidthRequest="76"
                MinimumHeightRequest="44"
                VerticalOptions="Center" />

            <Label
                Grid.Column="1"
                Text="{Binding PageTitle}"
                Style="{StaticResource SectionHeader}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="0" />

            <Button
                Grid.Column="2"
                Text="{loc:Translate Common_Save}"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding CanSave}"
                Style="{StaticResource BtnTextStyle}"
                TextColor="{DynamicResource Primary}"
                MinimumWidthRequest="76"
                MinimumHeightRequest="44"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource SpacingM}" Spacing="{StaticResource SpacingL}">

                <!-- Amount hero -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXS}" HorizontalOptions="Center">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="{StaticResource SpacingXS}">
                        <Label
                            Text="$"
                            FontSize="{StaticResource TypeAmountPrefix}"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextTertiary}"
                            VerticalOptions="Center" />
                        <Entry
                            Text="{Binding AmountText}"
                            Keyboard="Numeric"
                            FontSize="{StaticResource TypeAmountHero}"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}"
                            BackgroundColor="Transparent"
                            HorizontalTextAlignment="Center"
                            WidthRequest="180" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="2" WidthRequest="120" Color="{DynamicResource Primary}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Description -->
                <Border Style="{StaticResource InputBorderStyle}">
                    <Entry Text="{Binding Description}" Placeholder="{loc:Translate AddExpense_DescriptionPlaceholder}" />
                </Border>

                <!-- Paid by -->
                <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                    <Label Text="{loc:Translate AddExpense_PaidBy}" Style="{StaticResource SectionHeaderTertiary}" />
                    <CollectionView ItemsSource="{Binding PayerOptions}" HeightRequest="76">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource SpacingM}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PayerOption">
                                <VerticalStackLayout Spacing="{StaticResource SpacingXS}" WidthRequest="60">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddExpenseViewModel}}, Path=SelectPayerCommand}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <controls:ProfileCircle
                                        ImageUrl="{Binding AvatarUrl}"
                                        Initials="{Binding Initials}"
                                        Diameter="{StaticResource AvatarSizeL}"
                                        HorizontalOptions="Center" />
                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="{StaticResource TypeLabel}"
                                        TextColor="{DynamicResource TextTertiary}"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="TailTruncation">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Split -->
                <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate AddExpense_Split}" Style="{StaticResource SectionHeaderTertiary}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource SegmentPillContainer}">
                            <HorizontalStackLayout Spacing="{StaticResource SpacingXS}">
                                <Button
                                    Text="{loc:Translate AddExpense_Equally}"
                                    Command="{Binding SplitEquallyCommand}"
                                    Style="{StaticResource SegmentButtonUnselected}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsManualSplit}" Value="False">
                                            <Setter Property="Style" Value="{StaticResource SegmentButtonSelected}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button
                                    Text="{loc:Translate AddExpense_Manually}"
                                    Command="{Binding SplitManuallyCommand}"
                                    Style="{StaticResource SegmentButtonUnselected}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsManualSplit}" Value="True">
                                            <Setter Property="Style" Value="{StaticResource SegmentButtonSelected}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Participants}" Spacing="{StaticResource SpacingXS}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExpenseParticipant">
                                <Grid ColumnDefinitions="Auto,Auto,*,90" ColumnSpacing="{StaticResource SpacingS}">
                                    <Grid.Padding>
                                        <Thickness Left="0" Top="{StaticResource SpacingXS}" Right="0" Bottom="{StaticResource SpacingXS}" />
                                    </Grid.Padding>
                                    <Border
                                        Grid.Column="0"
                                        BackgroundColor="Transparent"
                                        StrokeThickness="0"
                                        WidthRequest="44" HeightRequest="44"
                                        Padding="0"
                                        VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleIncludedCommand}" />
                                        </Border.GestureRecognizers>
                                        <Border Style="{StaticResource SplitCheckboxStyle}" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label
                                                Text="&#10003;"
                                                IsVisible="{Binding IsIncluded}"
                                                TextColor="{DynamicResource TextOnAccent}"
                                                FontSize="{StaticResource TypeCaption}"
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                    </Border>

                                    <controls:ProfileCircle
                                        Grid.Column="1"
                                        ImageUrl="{Binding AvatarUrl}"
                                        Initials="{Binding Initials}"
                                        Diameter="{StaticResource AvatarSizeS}" />

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding Name}"
                                        VerticalOptions="Center"
                                        LineBreakMode="TailTruncation" />

                                    <Border Grid.Column="3" Style="{StaticResource InputBorderStyle}" Padding="8,4">
                                        <Entry
                                            Text="{Binding OwesText}"
                                            Keyboard="Numeric"
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            HorizontalTextAlignment="End"
                                            FontSize="{StaticResource TypeCaption}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label
                        Text="{Binding RemainingText}"
                        Style="{StaticResource LabelTertiary}"
                        IsVisible="{Binding IsManualSplit}" />
                </VerticalStackLayout>

                <!-- Category -->
                <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                    <Label Text="{loc:Translate AddExpense_Category}" Style="{StaticResource SectionHeaderTertiary}" />
                    <CollectionView ItemsSource="{Binding CategoryChips}" HeightRequest="40">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource SpacingS}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryChip">
                                <Border Style="{StaticResource ChipBorderStyle}" VerticalOptions="Fill">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddExpenseViewModel}}, Path=SelectCategoryCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Name}" FontSize="{StaticResource TypeCaption}" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Repeat toggle: only offered in pure-add mode — an existing one-off Expense or
                     an existing RecurringExpense template can't be converted into the other. -->
                <Border Style="{StaticResource InputBorderStyle}" IsVisible="{Binding CanToggleRecurring}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate AddExpense_Repeat}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsRecurringMode}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Date: the visible row is decorative; a full-size transparent DatePicker on
                     top of it is the actual tap target, so the whole row opens the picker. -->
                <Border Style="{StaticResource InputBorderStyle}" IsVisible="{Binding IsRecurringMode, Converter={StaticResource InverseBoolConverter}}">
                    <Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingS}" InputTransparent="True">
                            <Label Grid.Column="0" Text="&#128197;" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding OccurredOnDisplay}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&#8250;" TextColor="{DynamicResource TextTertiary}" VerticalOptions="Center" />
                        </Grid>
                        <DatePicker Date="{Binding OccurredOn}" Opacity="0" />
                    </Grid>
                </Border>

                <!-- Start date + Frequency: recurring-mode-only counterpart to the date row above. -->
                <VerticalStackLayout Spacing="{StaticResource SpacingS}" IsVisible="{Binding IsRecurringMode}">
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingS}" InputTransparent="True">
                                <Label Grid.Column="0" Text="&#128197;" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding StartDateDisplay}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="&#8250;" TextColor="{DynamicResource TextTertiary}" VerticalOptions="Center" />
                            </Grid>
                            <DatePicker Date="{Binding StartDate}" Opacity="0" />
                        </Grid>
                    </Border>

                    <Label Text="{loc:Translate AddExpense_Frequency}" Style="{StaticResource SectionHeaderTertiary}" />
                    <CollectionView ItemsSource="{Binding FrequencyOptions}" HeightRequest="40">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource SpacingS}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecurringFrequencyOption">
                                <Border Style="{StaticResource ChipBorderStyle}" VerticalOptions="Fill">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddExpenseViewModel}}, Path=SelectFrequencyCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}" FontSize="{StaticResource TypeCaption}" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Receipt photo: tapping opens Take photo / Choose from gallery / Remove photo.
                     Grows taller once a photo is attached — a receipt is a tall document shot, and
                     the empty-state's compact 88px strip would otherwise crop it down to a sliver.
                     Hidden entirely in recurring mode — a receipt belongs to one materialized
                     instance, not an indefinitely-repeating template. -->
                <Border Style="{StaticResource ReceiptDropZone}" IsVisible="{Binding IsRecurringMode, Converter={StaticResource InverseBoolConverter}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ReceiptPreviewUrl, Converter={StaticResource StringNotEmptyConverter}}" Value="True">
                            <Setter Property="HeightRequest" Value="220" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickReceiptCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="{StaticResource SpacingXS}">
                            <Label Text="&#128247;" HorizontalOptions="Center" FontSize="{StaticResource TypeEmojiLg}" />
                            <Label
                                Text="{loc:Translate AddExpense_ReceiptPhoto}"
                                Style="{StaticResource LabelTertiary}"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Image
                            Source="{Binding ReceiptPreviewUrl}"
                            Aspect="AspectFit"
                            IsVisible="{Binding ReceiptPreviewUrl, Converter={StaticResource StringNotEmptyConverter}}" />
                        <ActivityIndicator
                            IsRunning="{Binding IsReceiptBusy}"
                            IsVisible="{Binding IsReceiptBusy}"
                            Color="{DynamicResource Primary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource SpacingS}" Margin="{StaticResource SpacingM}">
            <Label
                Text="{Binding ErrorMessage}"
                TextColor="{DynamicResource Danger}"
                FontSize="{StaticResource TypeCaption}"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
            <Button
                Text="{loc:Translate AddExpense_SaveExpense}"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding CanSave}"
                Style="{StaticResource BtnPrimaryStyle}" />
            <Button
                Text="{loc:Translate AddExpense_DeleteExpense}"
                Command="{Binding DeleteCommand}"
                Style="{StaticResource BtnOutlineDanger}"
                IsVisible="{Binding IsEditMode}" />
        </VerticalStackLayout>

        <ActivityIndicator
            Grid.Row="0" Grid.RowSpan="3"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{DynamicResource Primary}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- Receipt preview overlay: bigger view of the already-attached photo, with Change/Remove
             actions, instead of jumping straight to the source-picker action sheet on every tap. -->
        <BoxView Grid.Row="0" Grid.RowSpan="3" Color="Transparent" IsVisible="{Binding IsReceiptPreviewOpen}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseReceiptPreviewCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            Grid.Row="0" Grid.RowSpan="3"
            Style="{StaticResource ElevatedCard}"
            IsVisible="{Binding IsReceiptPreviewOpen}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Margin="{StaticResource SpacingM}">
            <Grid RowDefinitions="*,Auto" RowSpacing="{StaticResource SpacingS}">
                <Image Grid.Row="0" Source="{Binding ReceiptPreviewUrl}" Aspect="AspectFit" />
                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingS}">
                    <Button
                        Grid.Column="0"
                        Text="{loc:Translate AddExpense_ChangePhoto}"
                        Command="{Binding ChangeReceiptCommand}"
                        Style="{StaticResource BtnOutlinePrimary}" />
                    <Button
                        Grid.Column="1"
                        Text="{loc:Translate AddExpense_RemovePhoto}"
                        Command="{Binding RemoveReceiptCommand}"
                        Style="{StaticResource BtnOutlineDanger}" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
