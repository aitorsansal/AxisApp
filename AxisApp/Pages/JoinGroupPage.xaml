<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    x:Class="AxisApp.Pages.JoinGroupPage"
    x:DataType="vm:JoinGroupViewModel"
    Shell.NavBarIsVisible="False"
    Title="Invite people">

    <Grid RowDefinitions="100,*">

        <!-- Top bar: back / title. Extra top margin on Windows: this row otherwise renders
        directly under the native window caption buttons — see GroupDetailPage.xaml for the
        full explanation. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingS}">
            <Grid.Padding>
                <Thickness Left="{StaticResource SpacingM}" Top="0" Right="{StaticResource SpacingM}" Bottom="0" />
            </Grid.Padding>
            <Grid.Margin>
                <Thickness Left="0" Top="{StaticResource SpacingXL}" Right="0" Bottom="0" />
            </Grid.Margin>
            <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="44" HeightRequest="44" Padding="0">
                <Label
                    Text="&#8249;"
                    FontSize="{StaticResource TypeIcon}"
                    TextColor="{StaticResource TextPrimary}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            <Label
                Grid.Column="1"
                Text="Invite people"
                Style="{StaticResource SectionHeader}"
                Margin="0"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource SpacingM}" Spacing="{StaticResource SpacingL}">

                <!-- Share invite card -->
                <Border Style="{StaticResource ElevatedCard}" IsVisible="{Binding HasActiveGroup}">
                    <VerticalStackLayout Spacing="{StaticResource SpacingM}" HorizontalOptions="Center">
                        <Border
                            BackgroundColor="{StaticResource QrPlaceholderBg}"
                            WidthRequest="132" HeightRequest="132"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <!-- QR generation not wired yet; placeholder swatch -->
                            <Label Text="QR" TextColor="{StaticResource BgPrimary}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                        </Border>

                        <HorizontalStackLayout Spacing="{StaticResource SpacingS}">
                            <Label
                                Text="{Binding InviteCode}"
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="{StaticResource TypeTitle}"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />
                            <Border BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="44" HeightRequest="44" Padding="0">
                                <Label Text="&#128203;" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CopyLinkCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingS}" HorizontalOptions="Fill">
                            <Button
                                Grid.Column="0"
                                Text="Copy link"
                                Command="{Binding CopyLinkCommand}"
                                Style="{StaticResource BtnOutlinePrimary}" />
                            <Button
                                Grid.Column="1"
                                Text="Share"
                                Command="{Binding ShareCommand}"
                                Style="{StaticResource BtnPrimaryStyle}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Divider -->
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="{StaticResource SpacingS}" VerticalOptions="Center">
                    <BoxView Grid.Column="0" Style="{StaticResource SectionDivider}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="or join a group" Style="{StaticResource LabelTertiary}" />
                    <BoxView Grid.Column="2" Style="{StaticResource SectionDivider}" VerticalOptions="Center" />
                </Grid>

                <!-- Join by code -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                    <Border Grid.Column="0" Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding JoinCodeInput}" Placeholder="Enter invite code" />
                    </Border>
                    <Button
                        Grid.Column="1"
                        Text="Join"
                        Command="{Binding JoinByCodeCommand}"
                        Style="{StaticResource BtnPrimaryStyle}" />
                </Grid>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource Danger}"
                    FontSize="{StaticResource TypeCaption}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <!-- Add phantom member -->
                <VerticalStackLayout Spacing="{StaticResource SpacingS}" IsVisible="{Binding HasActiveGroup}">
                    <Label Text="Add a member by name" Style="{StaticResource SectionHeaderTertiary}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                        <Border Grid.Column="0" Style="{StaticResource InputBorderStyle}">
                            <Entry Text="{Binding NewPhantomName}" Placeholder="Name (no account needed yet)" />
                        </Border>
                        <Button
                            Grid.Column="1"
                            Text="Add"
                            Command="{Binding AddPhantomMemberCommand}"
                            Style="{StaticResource BtnPrimaryStyle}" />
                    </Grid>

                    <!-- Name-match suggestions: "are you sure this isn't someone who already exists?" -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding NameMatches}"
                        Spacing="{StaticResource SpacingS}"
                        IsVisible="{Binding HasNameMatches}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemberMatchItem">
                                <Border Style="{StaticResource ListItemCard}">
                                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                        <Border
                                            Grid.Column="0"
                                            Style="{StaticResource AvatarCirclePhantom}"
                                            WidthRequest="{StaticResource AvatarSizeS}" HeightRequest="{StaticResource AvatarSizeS}">
                                            <Label Text="{Binding Initials}" Style="{StaticResource AvatarInitialsLabel}" FontSize="14" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Member.DisplayName}" FontAttributes="Bold" />
                                            <Label
                                                Text="Already added elsewhere — link instead?"
                                                Style="{StaticResource LabelTertiary}"
                                                IsVisible="{Binding IsPhantom}" />
                                            <Label
                                                Text="Already on Axis — send them the invite code instead"
                                                Style="{StaticResource LabelTertiary}"
                                                IsVisible="{Binding IsRealAccount}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="2"
                                            Text="Link"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JoinGroupViewModel}}, Path=LinkExistingMemberCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BtnOutlinePrimary}"
                                            FontSize="{StaticResource TypeCaption}"
                                            Padding="12,8"
                                            MinimumHeightRequest="36"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsPhantom}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Pending invites -->
                <VerticalStackLayout Spacing="{StaticResource SpacingS}" IsVisible="{Binding HasActiveGroup}">
                    <Label Text="Pending invites" Style="{StaticResource SectionHeaderTertiary}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingInvites}" Spacing="{StaticResource SpacingS}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PendingInviteItem">
                                <Border Style="{StaticResource ListItemCard}">
                                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                        <Border Grid.Column="0" Style="{StaticResource AvatarCirclePhantom}" WidthRequest="{StaticResource AvatarSizeS}" HeightRequest="{StaticResource AvatarSizeS}">
                                            <Label Text="{Binding Initials}" Style="{StaticResource AvatarInitialsLabel}" FontSize="14" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Member.DisplayName}" FontAttributes="Bold" />
                                            <Label Text="Phantom member" Style="{StaticResource LabelTertiary}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="2"
                                            Text="Resend"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JoinGroupViewModel}}, Path=ResendCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BtnOutlinePrimary}"
                                            FontSize="{StaticResource TypeCaption}"
                                            Padding="12,8"
                                            MinimumHeightRequest="36"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            Grid.Row="0" Grid.RowSpan="2"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Primary}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>
</ContentPage>
