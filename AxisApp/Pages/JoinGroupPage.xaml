<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    xmlns:controls="clr-namespace:AxisApp.Controls"
    xmlns:loc="clr-namespace:AxisApp.Localization"
    x:Class="AxisApp.Pages.JoinGroupPage"
    x:DataType="vm:JoinGroupViewModel"
    Shell.NavBarIsVisible="False"
    Title="{loc:Translate JoinGroup_Title}">

    <Grid RowDefinitions="Auto,*">

        <controls:PageHeaderBar Grid.Row="0" HeaderTitle="{loc:Translate JoinGroup_Title}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource SpacingM}" Spacing="{StaticResource SpacingL}">

                <!-- Share invite card -->
                <Border Style="{StaticResource ElevatedCard}" IsVisible="{Binding HasActiveGroup}">
                    <VerticalStackLayout Spacing="{StaticResource SpacingM}" HorizontalOptions="Center">
                        <Border
                            BackgroundColor="{DynamicResource QrPlaceholderBg}"
                            WidthRequest="132" HeightRequest="132"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource ShapeControl}" />
                            </Border.StrokeShape>
                            <!-- QR generation not wired yet; placeholder swatch -->
                            <Label Text="QR" TextColor="{DynamicResource TextOnAccent}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                        </Border>

                        <HorizontalStackLayout Spacing="{StaticResource SpacingS}">
                            <Label
                                Text="{Binding InviteCode}"
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="{StaticResource TypeTitle}"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />
                            <Border BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="44" HeightRequest="44" Padding="0">
                                <Label Text="&#128203;" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CopyLinkCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingS}" HorizontalOptions="Fill">
                            <Button
                                Grid.Column="0"
                                Text="{loc:Translate JoinGroup_CopyLink}"
                                Command="{Binding CopyLinkCommand}"
                                Style="{StaticResource BtnOutlinePrimary}" />
                            <Button
                                Grid.Column="1"
                                Text="{loc:Translate Common_Share}"
                                Command="{Binding ShareCommand}"
                                Style="{StaticResource BtnPrimaryStyle}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Divider -->
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="{StaticResource SpacingS}" VerticalOptions="Center">
                    <BoxView Grid.Column="0" Style="{StaticResource SectionDivider}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{loc:Translate JoinGroup_OrJoinAGroup}" Style="{StaticResource LabelTertiary}" />
                    <BoxView Grid.Column="2" Style="{StaticResource SectionDivider}" VerticalOptions="Center" />
                </Grid>

                <!-- Join by code -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                    <Border Grid.Column="0" Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding JoinCodeInput}" Placeholder="{loc:Translate JoinGroup_CodePlaceholder}" />
                    </Border>
                    <Button
                        Grid.Column="1"
                        Text="{loc:Translate Common_Join}"
                        Command="{Binding JoinByCodeCommand}"
                        Style="{StaticResource BtnPrimaryStyle}" />
                </Grid>

                <!-- Add phantom member -->
                <VerticalStackLayout Spacing="{StaticResource SpacingS}" IsVisible="{Binding HasActiveGroup}">
                    <Label Text="{loc:Translate JoinGroup_AddMemberByName}" Style="{StaticResource SectionHeaderTertiary}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                        <Border Grid.Column="0" Style="{StaticResource InputBorderStyle}">
                            <Entry Text="{Binding NewPhantomName}" Placeholder="{loc:Translate JoinGroup_NamePlaceholder}" />
                        </Border>
                        <Button
                            Grid.Column="1"
                            Text="{loc:Translate Common_Add}"
                            Command="{Binding AddPhantomMemberCommand}"
                            Style="{StaticResource BtnPrimaryStyle}" />
                    </Grid>

                    <!-- Name-match suggestions: "are you sure this isn't someone who already exists?" -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding NameMatches}"
                        Spacing="{StaticResource SpacingS}"
                        IsVisible="{Binding HasNameMatches}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemberMatchItem">
                                <Border Style="{StaticResource ListItemCard}">
                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                        <Border
                                            Grid.Column="0"
                                            Style="{StaticResource AvatarCirclePhantom}"
                                            WidthRequest="{StaticResource AvatarSizeM}" HeightRequest="{StaticResource AvatarSizeM}">
                                            <Label Text="{Binding Initials}" Style="{StaticResource AvatarInitialsLabel}" FontSize="{StaticResource TypeCaption}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Member.DisplayName}" FontAttributes="Bold" />
                                            <Label
                                                Text="{loc:Translate JoinGroup_AlreadyElsewhere}"
                                                Style="{StaticResource LabelTertiary}"
                                                IsVisible="{Binding IsPhantom}" />
                                            <Label
                                                Text="{loc:Translate JoinGroup_AlreadyOnAxis}"
                                                Style="{StaticResource LabelTertiary}"
                                                IsVisible="{Binding IsRealAccount}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="2"
                                            Text="{loc:Translate Common_Link}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JoinGroupViewModel}}, Path=LinkExistingMemberCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BtnOutlinePrimary}"
                                            FontSize="{StaticResource TypeCaption}"
                                            Padding="{StaticResource SpacingS}"
                                            MinimumHeightRequest="36"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsPhantom}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Pending invites -->
                <VerticalStackLayout Spacing="{StaticResource SpacingS}" IsVisible="{Binding HasActiveGroup}">
                    <Label Text="{loc:Translate JoinGroup_PendingInvites}" Style="{StaticResource SectionHeaderTertiary}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingInvites}" Spacing="{StaticResource SpacingS}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PendingInviteItem">
                                <Border Style="{StaticResource ListItemCard}">
                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                        <Border Grid.Column="0" Style="{StaticResource AvatarCirclePhantom}" WidthRequest="{StaticResource AvatarSizeM}" HeightRequest="{StaticResource AvatarSizeM}">
                                            <Label Text="{Binding Initials}" Style="{StaticResource AvatarInitialsLabel}" FontSize="{StaticResource TypeCaption}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Member.DisplayName}" FontAttributes="Bold" />
                                            <Label Text="{loc:Translate JoinGroup_PhantomMember}" Style="{StaticResource LabelTertiary}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="2"
                                            Text="{loc:Translate Common_Resend}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JoinGroupViewModel}}, Path=ResendCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BtnOutlinePrimary}"
                                            FontSize="{StaticResource TypeCaption}"
                                            Padding="{StaticResource SpacingS}"
                                            MinimumHeightRequest="36"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            Grid.Row="0" Grid.RowSpan="2"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{DynamicResource Primary}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <controls:ErrorPopup Grid.Row="0" Grid.RowSpan="2" Message="{Binding ErrorMessage}" />

    </Grid>
</ContentPage>
