<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    xmlns:controls="clr-namespace:AxisApp.Controls"
    xmlns:loc="clr-namespace:AxisApp.Localization"
    x:Class="AxisApp.Pages.NewGroupPage"
    x:DataType="vm:NewGroupViewModel"
    Shell.NavBarIsVisible="False"
    Title="{loc:Translate NewGroup_Title}">

    <Grid RowDefinitions="Auto,*">

        <controls:PageHeaderBar Grid.Row="0" HeaderTitle="{loc:Translate NewGroup_Title}" />

        <VerticalStackLayout Grid.Row="1" Padding="{StaticResource SpacingM}" Spacing="{StaticResource SpacingL}">

            <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                <Label Text="{loc:Translate NewGroup_GroupName}" Style="{StaticResource SectionHeaderTertiary}" />
                <Border Style="{StaticResource InputBorderStyle}">
                    <Entry
                        x:Name="GroupNameEntry"
                        Text="{Binding GroupName}"
                        Placeholder="{loc:Translate NewGroup_NamePlaceholder}"
                        ReturnCommand="{Binding CreateCommand}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                <Label Text="{loc:Translate NewGroup_Currency}" Style="{StaticResource SectionHeaderTertiary}" />
                <Border Style="{StaticResource InputBorderStyle}">
                    <Picker
                        ItemsSource="{Binding CurrencyOptions}"
                        SelectedIndex="{Binding SelectedCurrencyIndex}"
                        Title="{loc:Translate NewGroup_CurrencyPlaceholder}" />
                </Border>
                <Label Text="{loc:Translate NewGroup_CurrencyHint}" Style="{StaticResource LabelTertiary}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                <Label Text="{loc:Translate NewGroup_Appearance}" Style="{StaticResource SectionHeaderTertiary}" />
                <CollectionView ItemsSource="{Binding ColorSwatches}" HeightRequest="44">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource SpacingS}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupColorSwatch">
                            <Border
                                Style="{StaticResource AccentSwatchBorder}"
                                BackgroundColor="{Binding Color}"
                                controls:Juice.PressScale="0.85"
                                controls:Juice.Selected="{Binding IsSelected}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NewGroupViewModel}}, Path=SelectColorCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <CollectionView ItemsSource="{Binding IconOptions}" HeightRequest="176">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="7" VerticalItemSpacing="{StaticResource SpacingS}" HorizontalItemSpacing="{StaticResource SpacingS}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupIconOption">
                            <Border
                                Style="{StaticResource GroupIconOptionBorder}"
                                WidthRequest="36" HeightRequest="36"
                                controls:Juice.PressScale="0.85"
                                controls:Juice.Selected="{Binding IsSelected}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NewGroupViewModel}}, Path=SelectIconCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{Binding Glyph}"
                                    FontFamily="Lucide"
                                    TextColor="{DynamicResource TextPrimary}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Button
                Text="{loc:Translate Common_Create}"
                Command="{Binding CreateCommand}"
                Style="{StaticResource BtnPrimaryStyle}" />

        </VerticalStackLayout>

        <ActivityIndicator
            Grid.Row="0" Grid.RowSpan="2"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{DynamicResource Primary}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <controls:ErrorPopup Grid.Row="0" Grid.RowSpan="2" Message="{Binding ErrorMessage}" />
        <controls:UpdateBanner Grid.Row="0" Grid.RowSpan="2" />

    </Grid>
</ContentPage>
