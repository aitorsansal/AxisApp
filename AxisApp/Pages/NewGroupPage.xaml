<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    x:Class="AxisApp.Pages.NewGroupPage"
    x:DataType="vm:NewGroupViewModel"
    Shell.NavBarIsVisible="False"
    Title="New group">

    <Grid RowDefinitions="100,*">

        <!-- Top bar: back / title. Extra top margin on Windows: this row otherwise renders
        directly under the native window caption buttons — see GroupDetailPage.xaml for the
        full explanation. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingS}">
            <Grid.Padding>
                <Thickness Left="{StaticResource SpacingM}" Top="0" Right="{StaticResource SpacingM}" Bottom="0" />
            </Grid.Padding>
            <Grid.Margin>
                <Thickness Left="0" Top="{StaticResource SpacingXL}" Right="0" Bottom="0" />
            </Grid.Margin>
            <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="44" HeightRequest="44" Padding="0">
                <Label
                    Text="&#8249;"
                    FontSize="{StaticResource TypeIcon}"
                    TextColor="{StaticResource TextPrimary}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            <Label
                Grid.Column="1"
                Text="New group"
                Style="{StaticResource SectionHeader}"
                Margin="0"
                VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="{StaticResource SpacingM}" Spacing="{StaticResource SpacingL}">

            <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                <Label Text="Group name" Style="{StaticResource SectionHeaderTertiary}" />
                <Border Style="{StaticResource InputBorderStyle}">
                    <Entry
                        x:Name="GroupNameEntry"
                        Text="{Binding GroupName}"
                        Placeholder="e.g. Roommates"
                        ReturnCommand="{Binding CreateCommand}" />
                </Border>
            </VerticalStackLayout>

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="{StaticResource Danger}"
                FontSize="{StaticResource TypeCaption}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button
                Text="Create"
                Command="{Binding CreateCommand}"
                Style="{StaticResource BtnPrimaryStyle}" />

        </VerticalStackLayout>

        <ActivityIndicator
            Grid.Row="0" Grid.RowSpan="2"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Primary}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>
</ContentPage>
