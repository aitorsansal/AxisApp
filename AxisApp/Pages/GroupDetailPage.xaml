<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    xmlns:controls="clr-namespace:AxisApp.Controls"
    xmlns:models="clr-namespace:AxisApp.Models"
    xmlns:local="clr-namespace:AxisApp"
    xmlns:loc="clr-namespace:AxisApp.Localization"
    x:Class="AxisApp.Pages.GroupDetailPage"
    x:DataType="vm:GroupDetailViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding GroupName}">

    <Grid>
    <Grid RowDefinitions="Auto,*">

        <controls:PageHeaderBar
            Grid.Row="0"
            HeaderTitle="{Binding GroupName}" />

        <!-- Custom overflow trigger drawn directly in the header row rather than using
        PageHeaderBar's built-in ShowOverflow — that one sits under Windows' native window caption
        buttons (minimize/maximize/close) in windowed mode and isn't reliably clickable there. This
        sits in the same visual slot but is a plain sibling in this page's own header row, so it
        can be repositioned independently of the shared control other pages also use. Margin
        mirrors PageHeaderBar's own Grid.Margin/Padding math so it lines up with the back chevron
        row above the content below. -->
        <Border
            Grid.Row="0"
            BackgroundColor="Transparent"
            StrokeThickness="0"
            WidthRequest="44" HeightRequest="44"
            Padding="0"
            HorizontalOptions="End"
            VerticalOptions="Start">
            <Border.Margin>
                <Thickness Left="0" Top="{StaticResource SpacingXL}" Right="{StaticResource SpacingM}" Bottom="0" />
            </Border.Margin>
            <Label
                Text="&#8942;"
                FontSize="{StaticResource TypeTitle}"
                TextColor="{StaticResource TextPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleGroupOptionsMenuCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Border>

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
                <ScrollView>
                    <VerticalStackLayout Spacing="{StaticResource SpacingL}">
                        <!-- Bottom padding reserves clearance under the floating "+ Add expense"
                        button (FabButtonStyle) so it never permanently covers the last list row. -->
                        <VerticalStackLayout.Padding>
                            <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingM}" Right="{StaticResource SpacingM}" Bottom="88" />
                        </VerticalStackLayout.Padding>

                        <Label
                            Text="{Binding ErrorMessage}"
                            TextColor="{StaticResource Danger}"
                            FontSize="{StaticResource TypeCaption}"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                        <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                <Label Grid.Column="0" Text="{loc:Translate GroupDetail_Balances}" Style="{StaticResource SectionHeaderTertiary}" VerticalOptions="Center" Margin="0" />
                                <Label
                                    Grid.Column="1"
                                    Text="{loc:Translate GroupDetail_Detailed}"
                                    Style="{StaticResource LabelTertiary}"
                                    VerticalOptions="Center" />
                                <Switch Grid.Column="2" IsToggled="{Binding IsPairwiseMode}" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Balances}" Spacing="{StaticResource SpacingS}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MemberBalanceItem">
                                        <Border Style="{StaticResource BalanceTileSettled}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsOwed}" Value="True">
                                                    <Setter Property="Style" Value="{StaticResource BalanceTileReceive}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsOwing}" Value="True">
                                                    <Setter Property="Style" Value="{StaticResource BalanceTilePay}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                                <Border Grid.Column="0" Style="{StaticResource AvatarCircle}" WidthRequest="{StaticResource AvatarSizeM}" HeightRequest="{StaticResource AvatarSizeM}" Opacity="0.85">
                                                    <Label Text="{Binding Initials}" Style="{StaticResource AvatarInitialsLabel}" FontSize="{StaticResource TypeCaption}" />
                                                </Border>
                                                <Label Grid.Column="1" Text="{Binding Member.DisplayName}" VerticalOptions="Center" FontAttributes="Bold" LineBreakMode="TailTruncation">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsOwing}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                                    <Label Text="{Binding AmountText}" FontSize="{StaticResource TypeTitle}" FontAttributes="Bold" HorizontalTextAlignment="End">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOwing}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Text="{Binding CaptionText}" FontSize="{StaticResource TypeCaption}" HorizontalTextAlignment="End">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOwing}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </VerticalStackLayout>
                                                <Button
                                                    Grid.Column="3"
                                                    Text="{loc:Translate GroupDetail_Settle}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailViewModel}}, Path=SettleCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource BtnOutlinePrimary}"
                                                    FontSize="{StaticResource TypeCaption}"
                                                    Padding="{StaticResource SpacingS}"
                                                    MinimumHeightRequest="36"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                            <Label Text="{loc:Translate GroupDetail_RecentActivity}" Style="{StaticResource SectionHeaderTertiary}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivity}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActivityItem">
                                        <Border Style="{StaticResource ListItemCard}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailViewModel}}, Path=OpenActivityCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                                <Border Grid.Column="0" Style="{StaticResource AvatarCircle}" WidthRequest="{StaticResource AvatarSizeM}" HeightRequest="{StaticResource AvatarSizeM}">
                                                    <Label
                                                        Text="{x:Static local:AppConstants+Icons.ShoppingCart}"
                                                        FontFamily="Lucide"
                                                        FontSize="{StaticResource TypeBody}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsSettlement}" Value="True">
                                                                <Setter Property="Text" Value="{x:Static local:AppConstants+Icons.ArrowRight}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Description}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding SubCaption}" Style="{StaticResource LabelTertiary}" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                                    <Label
                                                        Text="{Binding AmountText}"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="End">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsSettlement}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Text="{Binding RelativeDate}" Style="{StaticResource LabelTertiary}" HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <Button
                Text="+"
                Command="{Binding AddExpenseCommand}"
                Style="{StaticResource FabButtonStyle}" />
        </Grid>
    </Grid>

    <!-- Scrim: tap anywhere outside the group options menu to dismiss it -->
    <BoxView Color="Transparent" IsVisible="{Binding IsGroupOptionsMenuOpen}">
        <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ToggleGroupOptionsMenuCommand}" />
        </BoxView.GestureRecognizers>
    </BoxView>

    <Border
        Style="{StaticResource ElevatedCard}"
        IsVisible="{Binding IsGroupOptionsMenuOpen}"
        HorizontalOptions="End"
        VerticalOptions="Start"
        Margin="0,58,16,0"
        WidthRequest="220"
        Padding="0">
        <VerticalStackLayout>
            <Label Text="{loc:Translate GroupDetail_ViewMembers}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewMembersCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <BoxView Style="{StaticResource SectionDivider}" HeightRequest="1" />
            <Label Text="{loc:Translate GroupDetail_LeaveGroup}" IsVisible="{Binding IsGroupCreator, Converter={StaticResource InverseBoolConverter}}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LeaveGroupCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="{loc:Translate GroupDetail_TransferOwnership}" IsVisible="{Binding IsGroupCreator}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTransferPickerCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <BoxView Style="{StaticResource SectionDivider}" HeightRequest="1" IsVisible="{Binding IsGroupCreator}" />
            <Label Text="{loc:Translate GroupDetail_DissolveGroup}" TextColor="{StaticResource Danger}" IsVisible="{Binding IsGroupCreator}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DissolveGroupCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </Border>

    <!-- Scrim + picker for choosing who to transfer ownership to -->
    <BoxView Color="Transparent" IsVisible="{Binding IsTransferPickerOpen}">
        <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CancelTransferPickerCommand}" />
        </BoxView.GestureRecognizers>
    </BoxView>

    <Border
        Style="{StaticResource ElevatedCard}"
        IsVisible="{Binding IsTransferPickerOpen}"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        WidthRequest="260">
        <VerticalStackLayout Spacing="{StaticResource SpacingS}">
            <Label Text="{loc:Translate GroupDetail_TransferOwnershipTitle}" Style="{StaticResource SectionHeaderTertiary}" Margin="0" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TransferCandidates}" Spacing="{StaticResource SpacingXS}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Member">
                        <Border Style="{StaticResource ListItemCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailViewModel}}, Path=TransferOwnershipCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding DisplayName}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label
                Text="{loc:Translate GroupDetail_NoTransferCandidates}"
                Style="{StaticResource LabelTertiary}"
                IsVisible="{Binding HasTransferCandidates, Converter={StaticResource InverseBoolConverter}}" />

            <Button
                Text="{loc:Translate Common_Cancel}"
                Command="{Binding CancelTransferPickerCommand}"
                Style="{StaticResource BtnOutlinePrimary}" />
        </VerticalStackLayout>
    </Border>
    </Grid>
</ContentPage>
