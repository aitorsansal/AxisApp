<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    xmlns:controls="clr-namespace:AxisApp.Controls"
    xmlns:local="clr-namespace:AxisApp"
    x:Class="AxisApp.Pages.GroupDetailPage"
    x:DataType="vm:GroupDetailViewModel"
    Shell.NavBarIsVisible="False"
    Title="Group">

    <Grid RowDefinitions="Auto,*">

        <controls:PageHeaderBar
            Grid.Row="0"
            HeaderTitle="{Binding GroupName}"
            ShowOverflow="True"
            OverflowCommand="{Binding InvitePeopleCommand}" />

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
                <ScrollView>
                    <VerticalStackLayout Spacing="{StaticResource SpacingL}">
                        <!-- Bottom padding reserves clearance under the floating "+ Add expense"
                        button (FabButtonStyle) so it never permanently covers the last list row. -->
                        <VerticalStackLayout.Padding>
                            <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingM}" Right="{StaticResource SpacingM}" Bottom="88" />
                        </VerticalStackLayout.Padding>

                        <!-- Regular, always-reachable entry point for InvitePeopleCommand — the
                        header's overflow "⋮" (Grid.Column 2 above) sits under Windows' native
                        caption buttons in windowed mode and isn't reliably clickable there. -->
                        <Button
                            Text="+ Invite people"
                            Command="{Binding InvitePeopleCommand}"
                            Style="{StaticResource BtnOutlinePrimary}" />

                        <Label
                            Text="{Binding ErrorMessage}"
                            TextColor="{StaticResource Danger}"
                            FontSize="{StaticResource TypeCaption}"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                        <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                <Label Grid.Column="0" Text="Balances" Style="{StaticResource SectionHeaderTertiary}" VerticalOptions="Center" Margin="0" />
                                <Label
                                    Grid.Column="1"
                                    Text="Detailed"
                                    Style="{StaticResource LabelTertiary}"
                                    VerticalOptions="Center" />
                                <Switch Grid.Column="2" IsToggled="{Binding IsPairwiseMode}" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Balances}" Spacing="{StaticResource SpacingS}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MemberBalanceItem">
                                        <Border Style="{StaticResource BalanceTileSettled}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsOwed}" Value="True">
                                                    <Setter Property="Style" Value="{StaticResource BalanceTileReceive}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsOwing}" Value="True">
                                                    <Setter Property="Style" Value="{StaticResource BalanceTilePay}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                                <Border Grid.Column="0" Style="{StaticResource AvatarCircle}" WidthRequest="{StaticResource AvatarSizeM}" HeightRequest="{StaticResource AvatarSizeM}" Opacity="0.85">
                                                    <Label Text="{Binding Initials}" Style="{StaticResource AvatarInitialsLabel}" FontSize="{StaticResource TypeCaption}" />
                                                </Border>
                                                <Label Grid.Column="1" Text="{Binding Member.DisplayName}" VerticalOptions="Center" FontAttributes="Bold" LineBreakMode="TailTruncation">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsOwing}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                                    <Label Text="{Binding AmountText}" FontSize="{StaticResource TypeTitle}" FontAttributes="Bold" HorizontalTextAlignment="End">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOwing}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Text="{Binding CaptionText}" FontSize="{StaticResource TypeCaption}" HorizontalTextAlignment="End">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOwing}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </VerticalStackLayout>
                                                <Button
                                                    Grid.Column="3"
                                                    Text="Settle"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailViewModel}}, Path=SettleCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource BtnOutlinePrimary}"
                                                    FontSize="{StaticResource TypeCaption}"
                                                    Padding="{StaticResource SpacingS}"
                                                    MinimumHeightRequest="36"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                            <Label Text="Recent activity" Style="{StaticResource SectionHeaderTertiary}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivity}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActivityItem">
                                        <Border Style="{StaticResource ListItemCard}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailViewModel}}, Path=OpenActivityCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="{StaticResource SpacingS}">
                                                <Border Grid.Column="0" Style="{StaticResource AvatarCircle}" WidthRequest="{StaticResource AvatarSizeM}" HeightRequest="{StaticResource AvatarSizeM}">
                                                    <Label
                                                        Text="{x:Static local:AppConstants+Icons.ShoppingCart}"
                                                        FontFamily="Lucide"
                                                        FontSize="{StaticResource TypeBody}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsSettlement}" Value="True">
                                                                <Setter Property="Text" Value="{x:Static local:AppConstants+Icons.ArrowRight}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Description}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding SubCaption}" Style="{StaticResource LabelTertiary}" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                                    <Label
                                                        Text="{Binding AmountText}"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="End">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsSettlement}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Text="{Binding RelativeDate}" Style="{StaticResource LabelTertiary}" HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <Button
                Text="+"
                Command="{Binding AddExpenseCommand}"
                Style="{StaticResource FabButtonStyle}" />
        </Grid>
    </Grid>
</ContentPage>
