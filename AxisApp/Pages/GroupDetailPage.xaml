<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AxisApp.ViewModels"
    xmlns:controls="clr-namespace:AxisApp.Controls"
    xmlns:views="clr-namespace:AxisApp.Views"
    xmlns:models="clr-namespace:AxisApp.Models"
    xmlns:local="clr-namespace:AxisApp"
    xmlns:loc="clr-namespace:AxisApp.Localization"
    x:Class="AxisApp.Pages.GroupDetailPage"
    x:DataType="vm:GroupDetailViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding GroupName}">

    <Grid>
    <Grid RowDefinitions="Auto,*">

        <controls:PageHeaderBar
            Grid.Row="0"
            HeaderTitle="{Binding GroupName}" />

        <!-- Custom overflow trigger drawn directly in the header row rather than using
        PageHeaderBar's built-in ShowOverflow — that one sits under Windows' native window caption
        buttons (minimize/maximize/close) in windowed mode and isn't reliably clickable there. This
        sits in the same visual slot but is a plain sibling in this page's own header row, so it
        can be repositioned independently of the shared control other pages also use. Margin
        mirrors PageHeaderBar's own Grid.Margin/Padding math so it lines up with the back chevron
        row above the content below. -->
        <Border
            Grid.Row="0"
            BackgroundColor="Transparent"
            StrokeThickness="0"
            WidthRequest="44" HeightRequest="44"
            Padding="0"
            HorizontalOptions="End"
            VerticalOptions="Start">
            <Border.Margin>
                <Thickness Left="0" Top="{StaticResource SpacingXL}" Right="{StaticResource SpacingM}" Bottom="0" />
            </Border.Margin>
            <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleGroupOptionsMenuCommand}" />
            </Border.GestureRecognizers>
            <Label
                Text="&#8942;"
                FontSize="{StaticResource TypeTitle}"
                TextColor="{DynamicResource TextPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            </Label>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">

            <!-- Expenses/Events/Stats tab selector — an in-page flip (SelectExpensesTab/
            SelectEventsTab/SelectStatsTabCommand), never a Shell navigation, so the back button
            always leaves the group rather than un-flipping the tab first. See /EVENTS_PLAN.md
            Milestone 2. Widened from 220 (2 columns) to 340 (3), plus tighter per-button padding
            and a smaller font below, than SegmentButtonBase's default (16px horizontal padding at
            TypeCaption 12pt) — at 3 equal columns that clipped "Estadísticas" (Spanish for Stats,
            the longest of the three labels) against its 100-113px column width. -->
            <Border Grid.Row="0" Style="{StaticResource SegmentPillContainer}" HorizontalOptions="Center" WidthRequest="340">
                <Border.Margin>
                    <Thickness Left="0" Top="{StaticResource SpacingS}" Right="0" Bottom="{StaticResource SpacingS}" />
                </Border.Margin>
                <Grid ColumnDefinitions="*,*,*">
                    <Border
                        Grid.Column="0"
                        Background="{DynamicResource Primary}"
                        StrokeThickness="0"
                        controls:Juice.SlideIndex="{Binding SelectedTabIndex}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource ShapePill}" />
                        </Border.StrokeShape>
                    </Border>
                    <Button
                        Grid.Column="0"
                        Text="{loc:Translate GroupDetail_ExpensesTab}"
                        Command="{Binding SelectExpensesTabCommand}"
                        Style="{StaticResource SegmentButtonUnselected}"
                        FontSize="11"
                        Padding="{StaticResource SpacingS}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsExpensesTabSelected}" Value="True">
                                <Setter Property="Style" Value="{StaticResource SegmentButtonSelectedTextOnly}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Text="{loc:Translate GroupDetail_EventsTab}"
                        Command="{Binding SelectEventsTabCommand}"
                        Style="{StaticResource SegmentButtonUnselected}"
                        FontSize="11"
                        Padding="{StaticResource SpacingS}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsEventsTabSelected}" Value="True">
                                <Setter Property="Style" Value="{StaticResource SegmentButtonSelectedTextOnly}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Text="{loc:Translate GroupDetail_StatsTab}"
                        Command="{Binding SelectStatsTabCommand}"
                        FontSize="11"
                        Padding="{StaticResource SpacingS}"
                        Style="{StaticResource SegmentButtonUnselected}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsStatsTabSelected}" Value="True">
                                <Setter Property="Style" Value="{StaticResource SegmentButtonSelectedTextOnly}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- IsVisible lives on a wrapping Grid, not on GroupExpensesView/GroupEventsView/
                GroupStatsView themselves — putting BindingContext and IsVisible on the SAME
                element meant IsVisible's compiled binding resolved against the new BindingContext
                (ExpensesVm/EventsVm/StatsVm, none of which has IsExpensesTabSelected etc.) instead
                of the page's GroupDetailViewModel, so it silently failed and every tab's content
                stayed visible (found live, stacked on top of each other, back when this was a
                2-tab bool). -->
                <Grid IsVisible="{Binding IsExpensesTabSelected}">
                    <views:GroupExpensesView BindingContext="{Binding ExpensesVm}" />
                </Grid>
                <Grid IsVisible="{Binding IsEventsTabSelected}">
                    <views:GroupEventsView BindingContext="{Binding EventsVm}" />
                </Grid>
                <Grid IsVisible="{Binding IsStatsTabSelected}">
                    <views:GroupStatsView BindingContext="{Binding StatsVm}" />
                </Grid>

                <!-- FAB context-switches per tab — overlaid buttons, each visible only for its own
                tab, rather than one button with a dynamically-swapped command. Stats has no FAB
                (nothing to add from a read-only aggregation screen). -->
                <Button
                    Text="+"
                    Command="{Binding ExpensesVm.AddExpenseCommand}"
                    Style="{StaticResource FabButtonStyle}"
                    IsVisible="{Binding IsExpensesTabSelected}"
                    controls:Juice.PressScale="0.88" />
                <Button
                    Text="+"
                    Command="{Binding EventsVm.AddEventCommand}"
                    Style="{StaticResource FabButtonStyle}"
                    IsVisible="{Binding IsEventsTabSelected}"
                    controls:Juice.PressScale="0.88" />
            </Grid>
        </Grid>
    </Grid>

    <!-- Scrim: tap anywhere outside the group options menu to dismiss it -->
    <BoxView Color="Transparent" IsVisible="{Binding IsGroupOptionsMenuOpen}">
        <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ToggleGroupOptionsMenuCommand}" />
        </BoxView.GestureRecognizers>
    </BoxView>

    <Border
        Style="{StaticResource ElevatedCard}"
        IsVisible="{Binding IsGroupOptionsMenuOpen}"
        HorizontalOptions="End"
        VerticalOptions="Start"
        Margin="0,58,16,0"
        WidthRequest="220"
        Padding="0">
        <VerticalStackLayout>
            <Label Text="{loc:Translate GroupDetail_ViewMembers}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewMembersCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Offered to every member, not just the creator — unlike Rename below, color/icon
            are cosmetic, not structural (see GroupDetailViewModel.OpenEditAppearanceOverlay). -->
            <BoxView Style="{StaticResource SectionDivider}" HeightRequest="1" />
            <Label Text="{loc:Translate GroupDetail_EditAppearance}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenEditAppearanceOverlayCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Expense-specific — only relevant while the Expenses tab is active (see
            /EVENTS_PLAN.md Milestone 2). -->
            <BoxView
                Style="{StaticResource SectionDivider}" HeightRequest="1"
                IsVisible="{Binding IsExpensesTabSelected}" />
            <Label
                Text="{loc:Translate GroupDetail_RepeatingExpenses}"
                IsVisible="{Binding IsExpensesTabSelected}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewRecurringExpensesCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <BoxView Style="{StaticResource SectionDivider}" HeightRequest="1" IsVisible="{Binding IsGroupCreator}" />
            <Label Text="{loc:Translate GroupDetail_RenameGroup}" IsVisible="{Binding IsGroupCreator}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenRenameGroupOverlayCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <BoxView Style="{StaticResource SectionDivider}" HeightRequest="1" />
            <Label Text="{loc:Translate GroupDetail_LeaveGroup}" IsVisible="{Binding IsGroupCreator, Converter={StaticResource InverseBoolConverter}}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LeaveGroupCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="{loc:Translate GroupDetail_TransferOwnership}" IsVisible="{Binding IsGroupCreator}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTransferPickerCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <BoxView Style="{StaticResource SectionDivider}" HeightRequest="1" IsVisible="{Binding IsGroupCreator}" />
            <Label Text="{loc:Translate GroupDetail_DissolveGroup}" TextColor="{DynamicResource Danger}" IsVisible="{Binding IsGroupCreator}">
                <Label.Padding>
                    <Thickness Left="{StaticResource SpacingM}" Top="{StaticResource SpacingS}" Right="{StaticResource SpacingM}" Bottom="{StaticResource SpacingS}" />
                </Label.Padding>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DissolveGroupCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </Border>

    <!-- Scrim + picker for choosing who to transfer ownership to -->
    <BoxView Color="Transparent" IsVisible="{Binding IsTransferPickerOpen}">
        <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CancelTransferPickerCommand}" />
        </BoxView.GestureRecognizers>
    </BoxView>

    <Border
        Style="{StaticResource ElevatedCard}"
        IsVisible="{Binding IsTransferPickerOpen}"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        WidthRequest="260">
        <VerticalStackLayout Spacing="{StaticResource SpacingS}">
            <Label Text="{loc:Translate GroupDetail_TransferOwnershipTitle}" Style="{StaticResource SectionHeaderTertiary}" Margin="0" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TransferCandidates}" Spacing="{StaticResource SpacingXS}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Member">
                        <Border Style="{StaticResource ListItemCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailViewModel}}, Path=TransferOwnershipCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding DisplayName}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label
                Text="{loc:Translate GroupDetail_NoTransferCandidates}"
                Style="{StaticResource LabelTertiary}"
                IsVisible="{Binding HasTransferCandidates, Converter={StaticResource InverseBoolConverter}}" />

            <Button
                Text="{loc:Translate Common_Cancel}"
                Command="{Binding CancelTransferPickerCommand}"
                Style="{StaticResource BtnOutlinePrimary}" />
        </VerticalStackLayout>
    </Border>

    <!-- Scrim + inline rename overlay — not DisplayPromptAsync, see GroupDetailViewModel.OpenRenameGroupOverlay remarks -->
    <BoxView Color="Transparent" IsVisible="{Binding IsRenameGroupOverlayOpen}">
        <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CancelRenameGroupOverlayCommand}" />
        </BoxView.GestureRecognizers>
    </BoxView>

    <Border
        Style="{StaticResource ElevatedCard}"
        IsVisible="{Binding IsRenameGroupOverlayOpen}"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        WidthRequest="280">
        <VerticalStackLayout Spacing="{StaticResource SpacingS}">
            <Border Style="{StaticResource InputBorderStyle}">
                <Entry Text="{Binding RenameGroupInput}" />
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingS}">
                <Button
                    Grid.Column="0"
                    Text="{loc:Translate Common_Cancel}"
                    Command="{Binding CancelRenameGroupOverlayCommand}"
                    Style="{StaticResource BtnOutlinePrimary}" />
                <Button
                    Grid.Column="1"
                    Text="{loc:Translate Common_Save}"
                    Command="{Binding ConfirmRenameGroupCommand}"
                    Style="{StaticResource BtnPrimaryStyle}" />
            </Grid>
        </VerticalStackLayout>
    </Border>

    <!-- Scrim + edit-appearance overlay — same shape as the rename overlay above -->
    <BoxView Color="Transparent" IsVisible="{Binding IsEditAppearanceOverlayOpen}">
        <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CancelEditAppearanceOverlayCommand}" />
        </BoxView.GestureRecognizers>
    </BoxView>

    <Border
        Style="{StaticResource ElevatedCard}"
        IsVisible="{Binding IsEditAppearanceOverlayOpen}"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        WidthRequest="300">
        <VerticalStackLayout Spacing="{StaticResource SpacingM}">
            <Label Text="{loc:Translate GroupDetail_EditAppearance}" Style="{StaticResource SectionHeaderTertiary}" Margin="0" />

            <CollectionView ItemsSource="{Binding AppearanceColorSwatches}" HeightRequest="44">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource SpacingS}" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupColorSwatch">
                        <Border
                            Style="{StaticResource AccentSwatchBorder}"
                            BackgroundColor="{Binding Color}"
                            controls:Juice.PressScale="0.85"
                            controls:Juice.Selected="{Binding IsSelected}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailViewModel}}, Path=SelectAppearanceColorCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView ItemsSource="{Binding AppearanceIconOptions}" HeightRequest="176">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="7" VerticalItemSpacing="{StaticResource SpacingS}" HorizontalItemSpacing="{StaticResource SpacingS}" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupIconOption">
                        <Border
                            Style="{StaticResource GroupIconOptionBorder}"
                            WidthRequest="36" HeightRequest="36"
                            controls:Juice.PressScale="0.85"
                            controls:Juice.Selected="{Binding IsSelected}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailViewModel}}, Path=SelectAppearanceIconCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="{Binding Glyph}"
                                FontFamily="Lucide"
                                TextColor="{DynamicResource TextPrimary}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingS}">
                <Button
                    Grid.Column="0"
                    Text="{loc:Translate Common_Cancel}"
                    Command="{Binding CancelEditAppearanceOverlayCommand}"
                    Style="{StaticResource BtnOutlinePrimary}" />
                <Button
                    Grid.Column="1"
                    Text="{loc:Translate Common_Save}"
                    Command="{Binding ConfirmEditAppearanceCommand}"
                    Style="{StaticResource BtnPrimaryStyle}" />
            </Grid>
        </VerticalStackLayout>
    </Border>

    <controls:ErrorPopup Message="{Binding ErrorMessage}" />
    <controls:UpdateBanner />
    </Grid>
</ContentPage>
