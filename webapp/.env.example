VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Same Firebase project as the Android app (AxisApp/Platforms/Android/google-services.json's
# project_id) — register a Web app under it in Firebase Console to get these. Not secrets, but
# also update the hardcoded copy of this config in public/sw.js (Vite doesn't process public/, so
# env vars there don't get substituted — see that file's own header comment).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=axisapp-ee018
VITE_FIREBASE_STORAGE_BUCKET=axisapp-ee018.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1080597749437
VITE_FIREBASE_APP_ID=

# Cloud Messaging → Web configuration → "Web Push certificates" — generate a key pair there.
VITE_FIREBASE_VAPID_KEY=
